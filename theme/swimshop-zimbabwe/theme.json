{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "black", "name": "Black", "color": "#0a0a0a" },
        { "slug": "navy", "name": "Navy", "color": "#081f3d" },
        { "slug": "light-grey", "name": "Light Grey", "color": "#f7f7f7" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "SwimShop Sans",
          "slug": "swimshop-sans"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#0a0a0a"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--swimshop-sans)"
    }
  }
}
